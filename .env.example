# ==============================================================================
# FLOWS HELPDESK — FULL DOCKER STACK ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=development
APP_NAME=Flows Helpdesk
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
API_PORT=4000

# --- MongoDB 8.0 Single-Node Replica Set (Docker internal hostname: mongodb) ---
MONGO_ROOT_USER=flows_admin
MONGO_ROOT_PASSWORD=flows_secret_change_me
MONGO_DB=flows_helpdesk
MONGO_URI=mongodb://flows_admin:flows_secret_change_me@mongodb:27017/flows_helpdesk?authSource=admin&replicaSet=rs0

# --- Redis 8.0 (Docker internal hostname: redis) ---
REDIS_PASSWORD=flows_redis_change_me
REDIS_URI=redis://:flows_redis_change_me@redis:6379

# --- RabbitMQ 4.4 (Docker internal hostname: rabbitmq) ---
RABBITMQ_USER=flows_mq
RABBITMQ_PASSWORD=flows_mq_change_me
RABBITMQ_VHOST=/flows-helpdesk
RABBITMQ_URI=amqp://flows_mq:flows_mq_change_me@rabbitmq:5672/%2Fflows-helpdesk

# --- MinIO / S3 Object Storage (Docker internal hostname: minio) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=flows-helpdesk-attachments
S3_ACCESS_KEY=flows_minio_admin
S3_SECRET_KEY=flows_minio_secret_change_me
S3_FORCE_PATH_STYLE=true

# --- Authentication & Encryption (HttpOnly Cookies + AES-256-GCM) ---
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_access_secret_key
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_refresh_secret_key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Default Support Email Gateway ---
DEFAULT_SUPPORT_EMAIL=support@sinchflows.io
DEFAULT_SENDER_NAME=Flows Helpdesk | Sinch Flows
